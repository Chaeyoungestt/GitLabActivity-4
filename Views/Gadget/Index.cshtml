@model IEnumerable<GadgetInventory.Models.Gadget>

@{
    ViewData["Title"] = "Gadget Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Gadget Inventory</h1>
    <a asp-controller="Gadget" asp-action="Create" class="btn btn-primary">Add New Gadget</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Brand</th>
                <th scope="col">Model Name</th>
                <th scope="col">Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var gadget in Model)
            {
                <tr>
                    <td>@gadget.Id</td>
                    <td>@gadget.Brand</td>
                    <td>@gadget.ModelName</td>
                    <td>@gadget.Price.ToString("C2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
